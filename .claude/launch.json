{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "static",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "-y",
        "serve",
        "."
      ],
      "port": 4173,
      "autoPort": true
    },
    {
      "name": "vercel-dev",
      "runtimeExecutable": "vercel",
      "runtimeArgs": [
        "dev",
        "--listen",
        "3000",
        "--yes"
      ],
      "port": 3000
    },
    {
      "name": "lj-live-dev",
      "runtimeExecutable": "vercel",
      "runtimeArgs": [
        "dev",
        "--cwd",
        "live-studio",
        "--listen",
        "3001",
        "--yes"
      ],
      "port": 3001
    }
  ]
}