{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-env-commit.js\"",
            "timeout": 15,
            "statusMessage": "Checking the commit for secret env files"
          }
        ]
      }
    ]
  }
}
